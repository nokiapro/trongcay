{
  "rules": {
    ".read": false,
    ".write": false,


    "agentIndex": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "plants": {
      ".read": "auth != null",
      ".write": "auth != null && (!root.child('users').exists() || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },

    "specialPlots": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && (!root.child('users').exists() || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },

    "announcements": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "mail": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$mid": {
          "read": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },

    "giftCodes": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$code": {
        "usedCount": {
          ".write": "auth != null && newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)"
        }
      }
    },

    "market": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('sellerUid').val() === auth.uid) || (data.exists() && data.child('sellerUid').val() === auth.uid) || (data.exists() && !newData.exists()))",
        ".validate": "!newData.exists() || (newData.hasChildren(['sellerUid', 'kind', 'itemId', 'qty', 'priceEach']) && newData.child('sellerUid').val() === auth.uid && newData.child('qty').isNumber() && newData.child('qty').val() > 0 && newData.child('priceEach').isNumber() && newData.child('priceEach').val() > 0 && (newData.child('kind').val() === 'seed' || newData.child('kind').val() === 'harvest'))"
      }
    },

    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "role": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && !root.child('users').exists() && newData.val() === 'admin') || (!data.exists() && auth.uid === $uid && newData.val() === 'user'))"
        },
        "banned": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },
        "banReason": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },
        "coins": {
          ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || (newData.isNumber() && (!data.exists() || newData.val() >= data.val())))"
        },
        "activity": {
          ".write": "auth != null"
        }
      }
    },

    "leaderboard": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$fid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $fid)"
        }
      }
    },

    "chatStreaks": {
      "$id": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "messages": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$mid": {
          ".validate": "newData.hasChildren(['from', 'text', 'at']) && newData.child('from').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500"
        }
      }
    },

    "publicGardens": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "gardenHelps": {
      "$ownerUid": {
        ".read": "auth != null && auth.uid === $ownerUid",
        "$fromUid": {
          ".write": "auth != null && (auth.uid === $fromUid || auth.uid === $ownerUid)"
        }
      }
    }
  }
}
